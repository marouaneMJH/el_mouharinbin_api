<!-- . Password Reset Email Template
Variables used:

appName - Your app name
userName - User's name
resetLink - Password reset URL
expiryTime - Link expiration time
supportEmail - Support contact
currentYear - Current year -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Password - <%= appName %>
    </title>
    <style>
        :root {
            --power-black: #0a0a0a;
            --power-charcoal: #1a1a1a;
            --anger-red: #dc2626;
            --anger-crimson: #991b1b;
            --masculine-navy: #1e40af;
            --discipline-gray: #374151;
            --text-primary: #ffffff;
            --text-secondary: #d1d5db;
            --text-muted: #9ca3af;
            --bg-card: #374151;
            --border-primary: #374151;
            --anger-gradient: linear-gradient(135deg, #dc2626 0%, #ea580c 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--power-black);
            color: var(--text-primary);
            line-height: 1.6;
            padding: 20px;
        }

        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background: var(--power-charcoal);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8);
        }

        .header {
            background: var(--anger-gradient);
            padding: 40px 30px;
            text-align: center;
        }

        .logo {
            font-size: 32px;
            font-weight: 900;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .header-subtitle {
            color: var(--text-secondary);
            font-size: 16px;
            font-weight: 500;
        }

        .content {
            padding: 40px 30px;
        }

        .greeting {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 20px;
            color: var(--text-primary);
        }

        .message {
            font-size: 16px;
            color: var(--text-secondary);
            margin-bottom: 30px;
            line-height: 1.7;
        }

        .reset-button {
            display: inline-block;
            background: var(--anger-gradient);
            color: var(--text-primary);
            text-decoration: none;
            padding: 16px 32px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 16px;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: transform 0.2s ease;
            margin: 20px 0;
        }

        .reset-button:hover {
            transform: translateY(-2px);
        }

        .expiry-notice {
            background: var(--bg-card);
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid var(--anger-red);
            margin: 30px 0;
        }

        .expiry-notice strong {
            color: var(--anger-red);
        }

        .footer {
            background: var(--power-black);
            padding: 30px;
            text-align: center;
            border-top: 1px solid var(--border-primary);
        }

        .footer-text {
            color: var(--text-muted);
            font-size: 14px;
            margin-bottom: 15px;
        }

        .support-link {
            color: var(--anger-red);
            text-decoration: none;
            font-weight: 600;
        }

        .security-note {
            background: var(--discipline-gray);
            padding: 20px;
            border-radius: 8px;
            margin-top: 20px;
        }

        .security-note h3 {
            color: var(--text-primary);
            margin-bottom: 10px;
            font-size: 18px;
        }

        @media (max-width: 600px) {
            .email-container {
                margin: 10px;
            }

            .header,
            .content,
            .footer {
                padding: 20px;
            }

            .logo {
                font-size: 24px;
            }
        }
    </style>
</head>

<body>
    <div class="email-container">
        <div class="header">
            <div class="logo">
                <%= appName %>
            </div>
            <div class="header-subtitle">Password Reset Request</div>
        </div>

        <div class="content">
            <div class="greeting">Hello <%= userName %>,</div>

            <div class="message">
                We received a request to reset your password for your <%= appName %> account.
                    If you made this request, click the button below to create a new password.
            </div>

            <div style="text-align: center;">
                <a href="<%= resetLink %>" class="reset-button">Reset Password</a>
            </div>

            <div class="expiry-notice">
                <strong>Important:</strong> This reset link will expire in <%= expiryTime %> for security reasons.
                    If you don't reset your password within this time, you'll need to request a new reset link.
            </div>

            <div class="security-note">
                <h3>Security Notice</h3>
                <p style="color: var(--text-secondary); font-size: 14px;">
                    If you didn't request this password reset, please ignore this email. Your account remains secure.
                    For additional security, consider enabling two-factor authentication.
                </p>
            </div>
        </div>

        <div class="footer">
            <div class="footer-text">
                Need help? Contact our support team at
                <a href="mailto:<%= supportEmail %>" class="support-link">
                    <%= supportEmail %>
                </a>
            </div>
            <div class="footer-text">
                &copy; <%= currentYear %>
                    <%= appName %>. All rights reserved.
            </div>
        </div>
    </div>
</body>

</html>