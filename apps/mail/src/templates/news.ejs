<!-- News Page
Variables used:

appName - Your app name
currentPage - Current navigation page
homeUrl, newsUrl, featuresUrl, supportUrl - Navigation URLs
featuredNews - Object with title, category, excerpt, author, publishDate, readMoreUrl
recentNews - Array of recent news items
categories - Array of news categories with icons and counts
stats - Object with activeUsers, currentVersion, lastUpdate
allNews - Array of all news articles
newsletterSignupUrl - Newsletter subscription URL
socialLinks - Object with social media URLs
supportEmail - Support contact
currentYear - Current year -->

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Latest News - <%= appName %>
    </title>
    <style>
        :root {
            --power-black: #0a0a0a;
            --power-charcoal: #1a1a1a;
            --power-slate: #1e293b;
            --anger-red: #dc2626;
            --anger-crimson: #991b1b;
            --masculine-navy: #1e40af;
            --discipline-blue: #1d4ed8;
            --discipline-gray: #374151;
            --text-primary: #ffffff;
            --text-secondary: #d1d5db;
            --text-muted: #9ca3af;
            --bg-card: #374151;
            --border-primary: #374151;
            --gold-accent: #f59e0b;
            --royal-purple: #7c3aed;
            --power-gradient: linear-gradient(135deg, #0a0a0a 0%, #1e293b 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--power-gradient);
            color: var(--text-primary);
            line-height: 1.6;
            min-height: 100vh;
        }

        .navbar {
            background: var(--power-charcoal);
            padding: 20px 0;
            border-bottom: 2px solid var(--anger-red);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 28px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--text-primary);
        }

        .nav-links {
            display: flex;
            gap: 30px;
        }

        .nav-links a {
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s ease;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--anger-red);
        }

        .hero-section {
            padding: 60px 20px;
            text-align: center;
            background: linear-gradient(135deg, var(--power-black) 0%, var(--masculine-navy) 100%);
        }

        .hero-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .hero-title {
            font-size: 48px;
            font-weight: 900;
            margin-bottom: 20px;
            background: linear-gradient(135deg, var(--anger-red) 0%, var(--gold-accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-subtitle {
            font-size: 20px;
            color: var(--text-secondary);
            margin-bottom: 30px;
        }

        .main-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .news-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 40px;
            margin-bottom: 60px;
        }

        .featured-news {
            background: var(--power-charcoal);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
            border: 1px solid var(--border-primary);
        }

        .featured-image {
            height: 250px;
            background: linear-gradient(135deg, var(--anger-red) 0%, var(--royal-purple) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 64px;
            color: white;
        }

        .featured-content {
            padding: 30px;
        }

        .news-category {
            display: inline-block;
            background: var(--anger-red);
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 15px;
        }

        .news-title {
            font-size: 28px;
            font-weight: 800;
            margin-bottom: 15px;
            color: var(--text-primary);
            line-height: 1.3;
        }

        .news-excerpt {
            color: var(--text-secondary);
            font-size: 16px;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .news-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: var(--text-muted);
            font-size: 14px;
        }

        .read-more {
            background: linear-gradient(135deg, var(--discipline-blue) 0%, var(--masculine-navy) 100%);
            color: white;
            text-decoration: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            transition: transform 0.3s ease;
        }

        .read-more:hover {
            transform: translateY(-2px);
        }

        .sidebar {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .sidebar-section {
            background: var(--power-charcoal);
            border-radius: 12px;
            padding: 25px;
            border: 1px solid var(--border-primary);
        }

        .sidebar-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 20px;
            color: var(--text-primary);
            border-bottom: 2px solid var(--anger-red);
            padding-bottom: 10px;
        }

        .news-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .news-item {
            display: flex;
            gap: 15px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-primary);
        }

        .news-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .news-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--royal-purple) 0%, var(--discipline-blue) 100%);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            flex-shrink: 0;
        }

        .news-content {
            flex: 1;
        }

        .news-content h4 {
            color: var(--text-primary);
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 5px;
            line-height: 1.3;
        }

        .news-content p {
            color: var(--text-muted);
            font-size: 14px;
        }

        .newsletter-section {
            background: var(--discipline-gray);
            padding: 40px;
            border-radius: 16px;
            text-align: center;
            margin: 60px 0;
        }

        .newsletter-title {
            font-size: 32px;
            font-weight: 800;
            margin-bottom: 15px;
            color: var(--text-primary);
        }

        .newsletter-form {
            display: flex;
            gap: 15px;
            max-width: 400px;
            margin: 30px auto 0;
        }

        .newsletter-input {
            flex: 1;
            padding: 15px;
            border: none;
            border-radius: 8px;
            background: var(--power-charcoal);
            color: var(--text-primary);
            font-size: 16px;
        }

        .newsletter-input::placeholder {
            color: var(--text-muted);
        }

        .newsletter-button {
            background: linear-gradient(135deg, var(--anger-red) 0%, var(--anger-crimson) 100%);
            color: white;
            border: none;
            padding: 15px 25px;
            border-radius: 8px;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .newsletter-button:hover {
            transform: translateY(-2px);
        }

        .footer {
            background: var(--power-black);
            padding: 40px 20px;
            text-align: center;
            border-top: 1px solid var(--border-primary);
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            color: var(--text-muted);
        }

        @media (max-width: 768px) {
            .news-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .hero-title {
                font-size: 32px;
            }

            .nav-links {
                display: none;
            }

            .newsletter-form {
                flex-direction: column;
            }

            .featured-content {
                padding: 20px;
            }
        }
    </style>
</head>

<body>
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <%= appName %>
            </div>
            <div class="nav-links">
                <a href="<%= homeUrl %>" class="<%= currentPage === 'home' ? 'active' : '' %>">Home</a>
                <a href="<%= newsUrl %>" class="<%= currentPage === 'news' ? 'active' : '' %>">News</a>
                <a href="<%= featuresUrl %>" class="<%= currentPage === 'features' ? 'active' : '' %>">Features</a>
                <a href="<%= supportUrl %>" class="<%= currentPage === 'support' ? 'active' : '' %>">Support</a>
            </div>
        </div>
    </nav>

    <section class="hero-section">
        <div class="hero-container">
            <h1 class="hero-title">Latest News & Updates</h1>
            <p class="hero-subtitle">Stay informed about <%= appName %>'s newest features, improvements, and
                    announcements</p>
        </div>
    </section>

    <div class="main-container">
        <div class="news-grid">
            <main class="featured-news">
                <div class="featured-image">📱</div>
                <div class="featured-content">
                    <span class="news-category">
                        <%= featuredNews.category %>
                    </span>
                    <h2 class="news-title">
                        <%= featuredNews.title %>
                    </h2>
                    <p class="news-excerpt">
                        <%= featuredNews.excerpt %>
                    </p>
                    <div class="news-meta">
                        <span>By <%= featuredNews.author %> • <%= featuredNews.publishDate %></span>
                        <a href="<%= featuredNews.readMoreUrl %>" class="read-more">Read More</a>
                    </div>
                </div>
            </main>

            <aside class="sidebar">
                <div class="sidebar-section">
                    <h3 class="sidebar-title">Recent Updates</h3>
                    <div class="news-list">
                        <% recentNews.forEach(function(news, index) { %>
                            <article class="news