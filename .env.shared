JWT_SECRET='secret'
JWT_REFRESH_SECRE='JWT_REFRESH_SECRET'
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d


# Postress variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=no-fap-db
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# For prisma
## Notice that the DATABASE_URL depend the POSTGRES_USER POSTGRES_DB POSTGRES_PORT
#DATABASE_URL="postgresql://postgres:12345@localhost:5433/no-fap-db?schema=public"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"
