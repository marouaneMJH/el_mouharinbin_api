{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/no-fap-api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/no-fap-api-gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/no-fap-api-gateway",
  "projects": {
    "contract": {
      "type": "library",
      "root": "libs/contract",
      "entryFile": "index",
      "sourceRoot": "libs/contract/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contract/tsconfig.lib.json"
      }
    },
    "mail": {
      "type": "application",
      "root": "apps/mail",
      "entryFile": "main",
      "sourceRoot": "apps/mail/src",
      "compilerOptions": {
        "tsConfigPath": "apps/mail/tsconfig.app.json",
        "assets": [
          {
            "include": "**/*.ejs",
            "outDir": "dist/apps/mail"
          },
          {
            "include": "templates/**/*",
            "outDir": "dist/apps/mail"
          }
        ]
      }
    },
    "no-fap-api-gateway": {
      "type": "application",
      "root": "apps/no-fap-api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/no-fap-api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/no-fap-api-gateway/tsconfig.app.json"
      }
    },
    "users": {
      "type": "application",
      "root": "apps/users",
      "entryFile": "main",
      "sourceRoot": "apps/users/src",
      "compilerOptions": {
        "tsConfigPath": "apps/users/tsconfig.app.json"
      }
    }
  }
}