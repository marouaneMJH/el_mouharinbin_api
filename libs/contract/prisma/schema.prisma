generator client {
  provider = "prisma-client-js"
  output   = "generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// On inclut tous les fichiers secondaires
// (disponible depuis Prisma 5.4+)
import "apps/users/prisma/user.prisma"
import "apps/chat/prisma/chat.prisma"
